					<string name="Name">mder</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">4bcba41f0748de220a0d4e0800000898</UniqueId>
