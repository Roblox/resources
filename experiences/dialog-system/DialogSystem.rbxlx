		<Item class="ModuleScript" referent="RBX373dd3255e924e9ba5f30e57c9c55bee">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Sets up the dialog system with CollectionService.
-- Tag Models or BaseParts with "dialog" and add a `DialogId` string attribute
-- to map to a dialog file in ReplicatedStorage.DialogData.
--
-- NPC animation playback (so every nearby player sees the same talking/gesture
-- animations) lives in the NPCAnimator child module.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NPCAnimator = require(script.NPCAnimator)

local DIALOG_TAG = "dialog"

local dialogFolder = ReplicatedStorage.DialogSystem

local DialogConfig = require(dialogFolder.DialogConfig)
local DialogData = require(dialogFolder.DialogLoader)

local remotesFolder = dialogFolder.Remotes

local startEvent = remotesFolder.StartDialog
local endEvent = remotesFolder.EndDialog
local screenEvent = remotesFolder.ScreenChanged

local DialogService = {}

-- player -> { npc, dialog } currently in dialog with that player.
-- Cache the resolved dialog so per-screen handlers don't have to re-derive
-- it from attributes.
type ActiveDialog = { npc: Instance, dialog: DialogData.Dialog }
local activeDialogs: { [Player]: ActiveDialog } = {}

-- Prompt and remotes
local function getPromptAdornee(npc: Instance): BasePart?
	if npc:IsA("BasePart") then
		return npc
	end
	if npc:IsA("Model") then
		return npc.PrimaryPart
	end
	return nil
end

local function setupPrompt(npc: Instance)
	local adornee = getPromptAdornee(npc)
	if not adornee then
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DialogPrompt"
	prompt.ActionText = DialogConfig.Prompt.ActionText
	prompt.HoldDuration = DialogConfig.Prompt.HoldDuration
	prompt.MaxActivationDistance = DialogConfig.Prompt.MaxActivationDistance
	prompt.RequiresLineOfSight = DialogConfig.Prompt.RequiresLineOfSight
	local displayName = npc:GetAttribute("DisplayName")
	prompt.ObjectText = if typeof(displayName) == "string" then displayName else npc.Name
	prompt.Parent = adornee

	prompt.Triggered:Connect(function(player: Player)
		local dialogId = npc:GetAttribute("DialogId")
		if typeof(dialogId) ~= "string" or dialogId == "" then
			-- Arguably these should be errors, but because they happen on prompt trigger,
			-- I'm choosing to warn instead.
			warn(`[DialogService] {npc:GetFullName()} is missing a DialogId attribute.`)
			return
		end
		local dialog = DialogData[dialogId]
		if not dialog then
			warn(`[DialogService] No dialog data for id "{dialogId}" (npc {npc:GetFullName()}).`)
			return
		end
		-- Check if the player is already talking to someone
		if activeDialogs[player] then
			return
		end
		activeDialogs[player] = { npc = npc, dialog = dialog }
		NPCAnimator.acquire(npc, dialog.animation)
		startEvent:FireClient(player, npc, dialogId)
	end)
end

local function teardownPrompt(npc: Instance)
	local prompt = npc:FindFirstChild("DialogPrompt", true)
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt:Destroy()
	end
    -- Stop animations in case dialog tag get removed mid-dialog.
	NPCAnimator.clear(npc)
end

function DialogService.start()

	-- Tag lifecycle
	for _, npc in CollectionService:GetTagged(DIALOG_TAG) do
		setupPrompt(npc)
	end
	CollectionService:GetInstanceAddedSignal(DIALOG_TAG):Connect(setupPrompt)
	CollectionService:GetInstanceRemovedSignal(DIALOG_TAG):Connect(teardownPrompt)

	-- Client tells us which screen the player just advanced to so we can play
	-- the matching mood gesture on the NPC for everyone to see.
	local function playScreenGesture(player: Player, screenIndex: number)
		if typeof(screenIndex) ~= "number" then
			return
		end
		local active = activeDialogs[player]
		if not active then
			return
		end
		local screen = active.dialog.screens[screenIndex]
		if not screen then
			return
		end
		local moodAnim = screen.mood and screen.mood.animation or nil
		NPCAnimator.playGesture(active.npc, moodAnim)
	end

	screenEvent.OnServerEvent:Connect(playScreenGesture)

	-- Called both when the client signals end-of-dialog and when the player leaves.
	local function endDialog(player: Player)
		local active = activeDialogs[player]
		activeDialogs[player] = nil
		if active then NPCAnimator.release(active.npc) end
	end

	endEvent.OnServerEvent:Connect(endDialog)
	Players.PlayerRemoving:Connect(endDialog)


end

return DialogService
]]></ProtectedString>
				<string name="ScriptGuid">{43b6c412-41b9-4cd1-8687-53074be1ab9f}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DialogService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">315e7d5b5051c6130a387f560000108c</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="RBXacd786d7fb474c8589c41a07a7128665">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Server-side animation playback for dialog NPCs. Owns a per-NPC reference count
-- and the currently playing animation tracks, so multiple players can converse
-- with the same NPC without one leaving cutting another's animations short. Driven
-- on the server so every nearby player sees the same talking/gesture animations.
--
-- Each NPC has two animation slots: base (looping idle) and gesture (mood animation).

local NPCAnimator = {}

local BASE_FADE = 0.20
local GESTURE_FADE = 0.15

type Slot = "base" | "gesture"

-- Tracks are keyed by slot name so playSlot can index them dynamically.
type AnimState = {
	refs: number,
	tracks: { [string]: AnimationTrack? },
}

local npcAnimState: { [Instance]: AnimState } = {}

local function findAnimator(npc: Instance): Animator?
	local controller = npc:FindFirstChildOfClass("Humanoid")
		or npc:FindFirstChildOfClass("AnimationController")
	if not controller then return nil end
	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = controller
		animator = created
	end
	return animator
end

local function stopTrack(track: AnimationTrack?, fadeTime: number?)
	if not track then
		return
	end
	track:Stop(fadeTime or GESTURE_FADE)
end

local function loadTrack(npc: Instance, assetId: string): AnimationTrack
	local animator = findAnimator(npc)
	if not animator then
		error(`[DialogService] {npc:GetFullName()} has no AnimationController or Humanoid; cannot load animation {assetId}.`)
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local track = animator:LoadAnimation(anim)
	anim:Destroy()
	if not track then
		error(`[DialogService] Failed to load animation {assetId} on {npc:GetFullName()}.`)
	end
	return track
end

local SLOT_CONFIG: { [Slot]: { fade: number, looped: boolean, priority: Enum.AnimationPriority } } = {
	base    = { fade = BASE_FADE, looped = true,  priority = Enum.AnimationPriority.Idle   },
	gesture = { fade = GESTURE_FADE, looped = false, priority = Enum.AnimationPriority.Action },
}

local function playSlot(npc: Instance, slot: Slot, assetId: string?)
	local state = npcAnimState[npc]
	if not state then
		return
	end
	local cfg = SLOT_CONFIG[slot]
	stopTrack(state.tracks[slot], cfg.fade)
	state.tracks[slot] = nil
	if not assetId or assetId == "" then
		return
	end
	local track = loadTrack(npc, assetId)
	track.Looped = cfg.looped
	track.Priority = cfg.priority
	track:Play(cfg.fade)
	state.tracks[slot] = track
end

-- Begin (or join) a conversation with the NPC
function NPCAnimator.acquire(npc: Instance, baseAnimId: string?)
	local state = npcAnimState[npc]
	if state then
		state.refs += 1
		return
	end
	npcAnimState[npc] = { refs = 1, tracks = {} }
	playSlot(npc, "base", baseAnimId)
end

-- Play the one-shot mood gesture, nil or "" to clear it
function NPCAnimator.playGesture(npc: Instance, gestureAnimId: string?)
	playSlot(npc, "gesture", gestureAnimId)
end

-- Leave a conversation. When the last participant leaves, every track stops
-- and the NPC's state is dropped.
function NPCAnimator.release(npc: Instance)
	local state = npcAnimState[npc]
	if not state then
		return
	end
	state.refs -= 1
	if state.refs > 0 then
		return
	end
	stopTrack(state.tracks["base"], BASE_FADE)
	stopTrack(state.tracks["gesture"], GESTURE_FADE)
	npcAnimState[npc] = nil
end

-- Force-stop and forget the NPC. Used when the NPC instance is being removed
-- mid-dialog.
function NPCAnimator.clear(npc: Instance)
	local state = npcAnimState[npc]
	if not state then
		return
	end
	stopTrack(state.tracks["base"], 0)
	stopTrack(state.tracks["gesture"], 0)
	npcAnimState[npc] = nil
end

return NPCAnimator
]]></ProtectedString>
